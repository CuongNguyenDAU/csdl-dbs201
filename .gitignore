# gốc đều KHÔNG được đẩy lên. Cần một ngoại lệ hợp pháp thì
# `git add -f` một cách có ý thức.
THAMKHAO/
*.pdf
*.pptx
*.ppt
*.docx
*.doc
*.xlsx
*.zip
*.rar

